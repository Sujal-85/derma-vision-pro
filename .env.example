# ==============================
# 🌐 DATABASE CONFIGURATION
# ==============================
MONGO_URI=mongodb://127.0.0.1:27017/derma_vision_pro

# ==============================
# ⚙️ SERVER CONFIGURATION
# ==============================
PORT=5000

# ==============================
# 🔐 SUPABASE CONFIGURATION
# Get yours from https://supabase.com/
# ==============================
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_public_key_here

# ==============================
# 📰 NEWS API
# Get your API key from https://newsapi.org/
# ==============================
NEWS_API_KEY=your_news_api_key_here

# ==============================
# 🧠 OPENROUTER API CONFIGURATION
# Get your API key from https://openrouter.ai/keys
# ==============================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================
# 🩺 MEDICAL AI CONFIGURATION
# (use mock data or real AI responses)
# ==============================
MEDICAL_AI_USE_MOCK=true

# ==============================
# 🤖 GOOGLE GEMINI API CONFIGURATION
# Get your API key from https://makersuite.google.com/app/apikey
# ==============================
GEMINI_API_KEY=your_google_gemini_api_key_here

# ==============================
# 🤗 HUGGING FACE API CONFIGURATION
# Get your API key from https://huggingface.co/settings/tokens
# ==============================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ==============================
# 🖥️ FRONTEND CONFIGURATION (VITE)
# ==============================
VITE_API_BASE_URL=http://localhost:5000
VITE_USE_LOCAL_AUTH=false
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================
# 🔑 OAUTH CONFIGURATION
# (Google & Microsoft Sign-In)
# ==============================
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# ==============================
# 🧍‍♂️ AZURE FACE API (optional)
# ==============================
AZURE_FACE_API_KEY=your_azure_face_api_key_here
